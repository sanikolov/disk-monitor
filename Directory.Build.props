<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <DiskMonitorVersion>1.0.2.0</DiskMonitorVersion>
    <Version>$(DiskMonitorVersion)</Version>
    <AssemblyVersion>$(DiskMonitorVersion)</AssemblyVersion>
    <FileVersion>$(DiskMonitorVersion)</FileVersion>
    <InformationalVersion>$(DiskMonitorVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
